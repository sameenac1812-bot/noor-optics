  "recommendations": {
    "Oval": {
      "stylingTip": "Most frame shapes suit an oval face. Angular shapes add contrast while classic wayfarers emphasize balanced symmetry.",
      "primaryShapes": ["Oval", "Wayfarer"],
      "complementaryShapes": ["Rectangular", "Hex / Geometric"]
    },
    "Round": {
      "stylingTip": "Angular and geometric frames contrast soft curves and add structure to the face profile.",
      "primaryShapes": ["Rectangular", "Square"],
      "complementaryShapes": ["Hex / Geometric", "Geometric"]
    },
    "Square": {
      "stylingTip": "Curved and round frames soften sharp jawline angles and bring subtle visual harmony.",
      "primaryShapes": ["Round", "Oval"],
      "complementaryShapes": ["Aviator", "Wayfarer", "Cat-Eye"]
    },
    "Heart": {
      "stylingTip": "Bottom-heavy or curved aviator and oval frames draw visual focus downward, balancing a wider forehead.",
      "primaryShapes": ["Aviator", "Oval", "Round"],
      "complementaryShapes": ["Cat-Eye", "Wayfarer", "Geometric"]
    },
    "Diamond": {
      "stylingTip": "Upswept frames like cat-eyes or delicate ovals highlight distinct cheekbones while softening angles.",
      "primaryShapes": ["Cat-Eye", "Oval"],
      "complementaryShapes": ["Hex / Geometric", "Geometric", "Round", "Aviator"]
    },
    "Oblong": {
      "stylingTip": "Taller, broader frames like squares and deep wayfarers visually break up face length.",
      "primaryShapes": ["Square", "Rectangular"],
      "complementaryShapes": ["Wayfarer"]
    }
  },

  "catalogFallback": {
    "minRecommendedFrames": 6,
    "expandToAdjacentSize": true,
    "expandToComplementaryShape": true,
    "comment": "Guarantees at least 6 recommendations by expanding to complementary styles or adjacent size bands if inventory is limited."
  }
}

