{
  "enabled": true,
  "version": "1.0.0",
  "comment": "Master configuration for Noor Optics 'Find Your Fit' face scanning & frame recommendation engine. All thresholds are editable.",

  "sizeBands": {
    "smallUpperMm": 126,
    "largeLowerMm": 136,
    "boundaryToleranceMm": 4,
    "labels": {
      "small": "Small",
      "medium": "Medium",
      "large": "Large",
      "boundarySmallMedium": "Small / Medium",
      "boundaryMediumLarge": "Medium / Large"
    },
    "catalogFitMapping": {
      "Small": ["Narrow"],
      "Medium": ["Regular", "M"],
      "Large": ["Wide"],
      "Small / Medium": ["Narrow", "Regular", "M"],
      "Medium / Large": ["Regular", "M", "Wide"]
    }
  },

  "calibration": {
    "irisDiameterMm": 11.7,
    "comment": "Horizontal Visible Iris Diameter (HVID) average in mm. Used as the optical reference ruler."
  },

  "quality": {
    "minFramesRequired": 40,
    "maxFramesBuffer": 80,
    "maxPoseYawDeg": 7.0,
    "maxPosePitchDeg": 7.0,
    "maxPoseRollDeg": 5.0,
    "minFaceToFrameRatio": 0.20,
    "maxFaceToFrameRatio": 0.78,
    "minBrightness": 40,
    "maxBrightness": 235,
    "maxJitterPixels": 12.0,
    "hairForeheadThreshold": 0.35,
    "glassesBridgeThreshold": 0.28,
    "varianceNotes": {
      "lengthVarianceMm": 4.0,
      "widthVarianceMm": 1.5,
      "jawVarianceMm": 1.8,
      "disclaimer": "Face width & jawline have highest optical precision (±1.5 mm). Face length has an estimated ±4 mm variance due to individual hairline variation."
    }
  },

  "borderline": {
    "scoreDeltaThreshold": 0.10,
    "comment": "When top two shape scores are within 0.10 (10%), display both as primary and secondary matches."
  },

  "shapes": {
    "Oval": {
      "displayName": "Oval",
      "description": "Balanced proportions with gently curved jawline and slightly wider cheekbones.",
      "targets": {
        "lengthToWidth": { "mean": 1.45, "sigma": 0.12, "weight": 0.30 },
        "jawToCheekbone": { "mean": 0.74, "sigma": 0.08, "weight": 0.25 },
        "foreheadToCheekbone": { "mean": 0.82, "sigma": 0.08, "weight": 0.20 },
        "foreheadToJaw": { "mean": 1.10, "sigma": 0.10, "weight": 0.15 },
        "jawAngleDeg": { "mean": 136.0, "sigma": 10.0, "weight": 0.10 }
      }
    },
    "Round": {
      "displayName": "Round",
      "description": "Soft contours with equal face width and length, gentle curves at cheekbones and jaw.",
      "targets": {
        "lengthToWidth": { "mean": 1.16, "sigma": 0.10, "weight": 0.35 },
        "jawToCheekbone": { "mean": 0.78, "sigma": 0.08, "weight": 0.20 },
        "foreheadToCheekbone": { "mean": 0.82, "sigma": 0.08, "weight": 0.15 },
        "foreheadToJaw": { "mean": 1.05, "sigma": 0.10, "weight": 0.15 },
        "jawAngleDeg": { "mean": 142.0, "sigma": 10.0, "weight": 0.15 }
      }
    },
    "Square": {
