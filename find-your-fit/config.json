      "targets": {
        "lengthToWidth": { "mean": 1.40, "sigma": 0.12, "weight": 0.20 },
        "jawToCheekbone": { "mean": 0.64, "sigma": 0.08, "weight": 0.30 },
        "foreheadToCheekbone": { "mean": 0.72, "sigma": 0.08, "weight": 0.30 },
        "foreheadToJaw": { "mean": 1.12, "sigma": 0.12, "weight": 0.10 },
        "jawAngleDeg": { "mean": 132.0, "sigma": 10.0, "weight": 0.10 }
      }
    },
    "Oblong": {
      "displayName": "Oblong / Rectangle",
      "description": "Elongated face profile with balanced cheekbone, forehead, and jaw width.",
      "targets": {
        "lengthToWidth": { "mean": 1.72, "sigma": 0.15, "weight": 0.40 },
        "jawToCheekbone": { "mean": 0.80, "sigma": 0.08, "weight": 0.20 },
        "foreheadToCheekbone": { "mean": 0.84, "sigma": 0.08, "weight": 0.15 },
