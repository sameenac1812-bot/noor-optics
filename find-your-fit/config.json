        "lengthToWidth": { "mean": 1.18, "sigma": 0.10, "weight": 0.30 },
        "jawToCheekbone": { "mean": 0.88, "sigma": 0.08, "weight": 0.30 },
        "foreheadToCheekbone": { "mean": 0.88, "sigma": 0.08, "weight": 0.15 },
        "foreheadToJaw": { "mean": 1.00, "sigma": 0.08, "weight": 0.10 },
        "jawAngleDeg": { "mean": 120.0, "sigma": 10.0, "weight": 0.15 }
      }
    },
    "Heart": {
      "displayName": "Heart",
      "description": "Broader forehead and cheekbones tapering down to a refined, pointed chin.",
      "targets": {
        "lengthToWidth": { "mean": 1.35, "sigma": 0.12, "weight": 0.20 },
        "jawToCheekbone": { "mean": 0.65, "sigma": 0.08, "weight": 0.25 },
        "foreheadToCheekbone": { "mean": 0.88, "sigma": 0.08, "weight": 0.20 },
        "foreheadToJaw": { "mean": 1.35, "sigma": 0.12, "weight": 0.25 },
